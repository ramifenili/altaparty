# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA subas .env.local al repositorio ni uses estas variables con prefijo NEXT_PUBLIC_.

# URL pública de la app. Mercado Pago necesita https para el webhook y el retorno automático.
# En desarrollo local puede ser http://localhost:3000 (sin webhook ni auto-retorno).
APP_URL=http://localhost:3000

# Access Token de Mercado Pago (Tus integraciones > Credenciales).
# Para pruebas usá las credenciales de prueba: empiezan con TEST-
MP_ACCESS_TOKEN=APP_USR-4291778895048292-103122-9339149488e0b95639b6169c38e6a221-3808344488

# Clave secreta del webhook (Tus integraciones > Webhooks > Clave secreta).
# Si está definida, el webhook exige firma válida. Obligatoria en producción.
MP_WEBHOOK_SECRET=944e422c295673a399f9c76057361a219f88944b286df21887c105aec517c76f

# Secreto propio para firmar las autorizaciones de descarga (cadena aleatoria larga).
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PURCHASE_TOKEN_SECRET=cambiar-por-una-cadena-aleatoria-larga-de-ejemplo

# (Opcional) Rate limit compartido entre instancias serverless: Upstash Redis, plan gratuito.
# Si no se definen, el límite funciona en memoria (válido para un servidor Node propio).
UPSTASH_REDIS_REST_URL=https://ejemplo-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=token-de-ejemplo

# SOLO para probar en tu computadora: pagos simulados (no pasa por Mercado Pago).
# Se ignora si APP_URL es un dominio público. Con esto podés usar el código PRUEBA-<plantilla>
# (ej.: PRUEBA-boca) en "¿Ya compraste tu video?" y generar sin marca de agua.
# MP_FAKE_PAYMENTS=1

# Panel interno (/admin): contraseña de 8+ caracteres. Si no se define, el panel queda desactivado.
ADMIN_PASSWORD=cambiar-por-una-contrasena-larga-de-ejemplo
# (Opcional) secreto para firmar la sesión del panel; por defecto usa PURCHASE_TOKEN_SECRET.
ADMIN_SECRET=otro-secreto-largo-de-ejemplo
